PORT=5000
NODE_ENV=production
# MongoDB connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/stereobliss_inventory
JWT_SECRET=your-secure-random-jwt-secret-here
SESSION_COOKIE_NAME=stereobliss_session
FRONTEND_URL=http://localhost:3000

# ========================================================
# EMAIL CONFIGURATION (Choose SMTP, Gmail, or Resend)
# ========================================================
# 1. OPTION A: Standard SMTP (Hostinger, Brevo, AWS SES, Zoho, Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM="Stereobliss" <your-email@gmail.com>

# 2. OPTION B: Gmail Direct App Password
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 3. OPTION C: Resend API Key
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=sales@yourdomain.com