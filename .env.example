PORT=5000
NODE_ENV=production
# In production, use MongoDB Atlas URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/soundstock_inventory?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/soundstock_inventory
JWT_SECRET=your-secure-random-jwt-secret-here
SESSION_COOKIE_NAME=soundstock_session
# Set to your Vercel frontend URL (e.g. https://your-project.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
EMAIL_FROM=inventory@soundstock.io
