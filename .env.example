PORT=5000
NODE_ENV=production
# MongoDB connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/stereobliss_inventory
JWT_SECRET=your-secure-random-jwt-secret-here
SESSION_COOKIE_NAME=stereobliss_session
FRONTEND_URL=http://localhost:3000

# ========================================================
# EMAIL CONFIGURATION (Resend Primary + Nodemailer Auto-Failover)
# ========================================================
# 1. PRIMARY ENGINE: Resend API (Fast HTTP API, Free tier gives 100 emails/day)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_DAILY_QUOTA=100
# If your domain is verified on Resend, set your custom sender; otherwise omit or use onboarding@resend.dev
RESEND_FROM="StereoBliss" <sales@yourdomain.com>

# 2. AUTO-FAILOVER ENGINE: Nodemailer (Auto-activates when 100 daily Resend emails are reached or rate limited)
# Option A: Gmail Direct App Password
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option B: Standard SMTP (Hostinger, Brevo, AWS SES, Zoho, Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM="StereoBliss" <your-email@gmail.com>