PORT=5000
NODE_ENV=production
# In production, use MongoDB Atlas URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/stereobliss_inventory?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/stereobliss_inventory
JWT_SECRET=your-secure-random-jwt-secret-here
SESSION_COOKIE_NAME=stereobliss_session
# Set to your Vercel frontend URL (e.g. https://your-project.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
EMAIL_FROM=inventory@stereobliss.com

